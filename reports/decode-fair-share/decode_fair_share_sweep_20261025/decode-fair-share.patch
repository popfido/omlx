+"""Configurable TTFT/streaming tradeoff, with existing safety policy retained."""
+from unittest.mock import MagicMock
+
+import pytest
+
+from omlx.decode_activity import get_decode_activity
+from omlx.scheduler import Scheduler, SchedulerConfig, _CONTENDED_PREFILL_CHUNK
+from omlx.settings import GlobalSettings, SchedulerSettings
+
+
+@pytest.fixture(autouse=True)
+def quiet_activity():
+    get_decode_activity().clear()
+    yield
+    get_decode_activity().clear()
+
+
+def scheduler(ratio):
+    model = MagicMock()
+    model.layers = []
+    s = Scheduler(model, MagicMock(), SchedulerConfig(
+        decode_fair_share=ratio, paged_cache_block_size=0))
+    s.running = {"decoder": MagicMock()}
+    return s
+
+
+def test_default_reserves_one_second_decode_after_two_seconds_prefill():
+    s = scheduler(SchedulerConfig().decode_fair_share)
+    s._accrue_decode_debt(2.0)
+    s._repay_decode_debt(.9)
+    assert not s._prefill_gate_open()
+    s._repay_decode_debt(.1)
+    assert s._prefill_gate_open()
+
+
+def test_zero_share_opens_gate_but_retains_chunk_cap_and_fairness():
+    s = scheduler(0)
+    s._accrue_decode_debt(2.0)
+    assert s._prefill_gate_open()
+    assert s._decode_fairness
+    assert s._contended_prefill_cap() == _CONTENDED_PREFILL_CHUNK
+
+
+def test_independent_engines_do_not_change_each_others_policy():
+    eager, normal = scheduler(0), scheduler(.5)
+    eager._accrue_decode_debt(2.0)
+    normal._accrue_decode_debt(2.0)
+    assert eager._prefill_gate_open()
+    assert not normal._prefill_gate_open()
+
+
+def test_low_share_preserves_positive_decode_guarantee():
+    s = scheduler(.1)
+    s._accrue_decode_debt(2.0)
+    s._repay_decode_debt(.19)
+    assert not s._prefill_gate_open()
+    s._repay_decode_debt(.02)
+    assert s._prefill_gate_open()
+
+
+def test_setting_survives_serialization_and_reaches_runtime(tmp_path):
+    settings = SchedulerSettings.from_dict({'decode_fair_share': 0})
+    restored = SchedulerSettings.from_dict(settings.to_dict())
+    global_settings = GlobalSettings(base_path=tmp_path, scheduler=restored)
+    global_settings.cache.enabled = False
+    assert global_settings.to_scheduler_config().decode_fair_share == 0
+
+
+@pytest.mark.parametrize('value', [-.1, 1.1, float('nan'), float('inf'), -float('inf')])
+def test_reject_invalid_share(value):
+    with pytest.raises(ValueError):
+        SchedulerSettings.from_dict({'decode_fair_share': value})
+    with pytest.raises(ValueError):
+        SchedulerConfig(decode_fair_share=value)
